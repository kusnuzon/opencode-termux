#!/data/data/com.termux/files/usr/bin/bash
# opencode-launcher — runs the opencode binary (glibc build) on Termux/Android.
#
# Used as $PREFIX/bin/opencode. The official opencode binary for linux-arm64
# needs a glibc loader, while Android only ships bionic. The glibc loader from
# Termux (the `glibc` package) is used as the interpreter.
#
# Do not edit directly; use: https://github.com/kusnuzon/opencode-termux
PREFIX="${PREFIX:-@PREFIX@}"
export LD_LIBRARY_PATH="$PREFIX/glibc/lib:${LD_LIBRARY_PATH:-}"
export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"
exec "$PREFIX/glibc/lib/ld-linux-aarch64.so.1" --library-path "$PREFIX/glibc/lib" "$PREFIX/share/opencode/opencode.real" "$@"
